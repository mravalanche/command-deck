# Loopback by default. Set a private LAN address explicitly for other devices.
COMMAND_DECK_BIND_ADDRESS=127.0.0.1
COMMAND_DECK_PORT=8765
# Compose uses config.yml by default. For a .yaml host file, set this to ./config.local.yaml.
# COMMAND_DECK_CONFIG_HOST_FILE=./config.local.yaml
# Use develop to test the integration build, or vX.Y.Z to pin a release instead of latest.
# COMMAND_DECK_IMAGE_TAG=develop
# Optional source overrides. Keep API keys in this ignored file.
# COMMAND_DECK_PROMETHEUS_URL=http://prometheus:9090
# COMMAND_DECK_PROMETHEUS_BEARER_TOKEN=configure-outside-version-control-if-needed
# Create a project-scoped read-only Management API key in Healthchecks Project Settings.
# COMMAND_DECK_HEALTHCHECKS_API_KEY=configure-outside-version-control
# COMMAND_DECK_HEALTHCHECKS_URL=https://healthchecks.example.invalid
# Uptime Kuma can expose /metrics without authentication; set a key only if your server requires it.
# COMMAND_DECK_UPTIME_KUMA_URL=https://kuma.example.invalid
# COMMAND_DECK_UPTIME_KUMA_API_KEY=configure-outside-version-control-if-needed
# TrueNAS 25.04+ capacity uses a dedicated account with POOL_READ and DATASET_READ.
# Use the HTTPS origin with a trusted certificate. Never put the API key in YAML.
# COMMAND_DECK_TRUENAS_URL=https://nas.example.invalid
# COMMAND_DECK_TRUENAS_USERNAME=dashboard_reader
# COMMAND_DECK_TRUENAS_API_KEY=configure-outside-version-control
